<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="org.mindone.snapcase.ui.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/ime_subtype_en" />

    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeLocale="ru_RU"
        android:imeSubtypeMode="keyboard"
        android:label="@string/ime_subtype_ru" />

    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeLocale="uk_UA"
        android:imeSubtypeMode="keyboard"
        android:label="@string/ime_subtype_uk" />

    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeLocale="ja_JP"
        android:imeSubtypeMode="keyboard"
        android:label="@string/ime_subtype_ja" />
</input-method>
